# 白名单仓库：默认忽略一切，只放行下面列出的文件。
# 关键：lll.conf / *.conf / *.bak 一律排除 —— lll.conf 里有
#       MITM CA 私钥口令（ca-passphrase / ca-p12）与机场订阅 token。
*
!.gitignore
!README.md
# Surge 生成表（由 refresh-ai-lists.sh 写入 surge/；嵌套路径需逐层放行父目录）
!surge/
!surge/AI-*.list
# 手写补充表（根目录；人工维护，脚本永不覆盖）
!AI-Supplement-OpenAI.list
!AI-Supplement-Claude.list
!AI-Supplement-Gemini.list
!AI-Supplement.list
!AI-CN.list
!AI-Supplement-CN.list
# Google 补充表（手写，四路上游核对后补的 .new/tenor/fitbit/idx.dev）
!Google-Supplement.list
!refresh-ai-lists.sh
!sync.sh
# GitHub Actions 工作流（嵌套路径需逐层放行父目录）
!.github/
!.github/workflows/
!.github/workflows/generate.yml
!check-ai-lists.sh
!check-novel.sh
!check-liveness.sh
!check-brand-isolation.sh
!check-clash.sh
!check-loon.sh
!to-clash.sh
# Clash/mihomo 产物（由 to-clash.sh 生成；嵌套路径需逐层放行父目录）
!clash/
!clash/*.yaml
